class Mahasiswa :
    nim = 0
    nama = ""

    def perkenalan(self):
        print(f"halo nama saya {self.nama}")

    def hello (self, nama):
        print(f"hello {nama},nama saya {self.nama}")


mahasiswa = Mahasiswa()
mahasiswa.nama = "esta"
mahasiswa.perkenalan()
mahasiswa.hello("queen")


